    } ]
  }, {
    "tStartMs": 6086880,
    "dDurationMs": 8239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "to your loved ones\nwhen they are going through a struggle.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6092080,
    "dDurationMs": 5680,
