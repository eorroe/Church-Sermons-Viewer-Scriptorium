    } ]
  }, {
    "tStartMs": 6053600,
    "dDurationMs": 11119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "love every day, day in day out.\n\u003e\u003e What small daily habits can you build",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6061760,
    "dDurationMs": 8080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "into your relationships, into your home\nto place Christ at the center?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6067760,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Maybe\nin your marriage you can start with five",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6071679,
    "dDurationMs": 7281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "minutes of prayer together.\nMaybe you can start in your home with a",
